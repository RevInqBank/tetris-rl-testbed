 "notes_ko": {
  "cap": "\uc870\uac01 \uc0c1\ud55c\uc5d0 \uac78\ub9b0 \uac8c\uc784\uc740 \ub05d\ub09c \uac8c\uc784\uc774 \uc544\ub2c8\ub2e4. \uadf8 \uc904 \uc218\ub294 \uc2e4\ub825\uc758 \uce21\uc815\uce58\uac00 \uc544\ub2c8\ub77c \ud3c9\uac00 \uc0c1\ud55c\uc774 \uc815\ud55c \ud558\ud55c\uc774\ub2e4. \uc0c1\ud55c \ub3c4\ub2ec\uc774 10/10 \uc778 \uc804\ub7b5\ub07c\ub9ac\ub294 \uc904 \uc218\ub85c \uc21c\uc704\ub97c \ub9e4\uae38 \uc218 \uc5c6\ub2e4.",
  "median": "\uc8fc \ud1b5\uacc4\ub294 \uc911\uc559\uac12\uc774\ub2e4. \uc774 \ubd84\ud3ec\ub4e4\uc740 \uaf2c\ub9ac\uac00 \ub450\uaebc\uc6cc\uc11c \ud55c \ud310\uc758 \uc6b4\uc774 \ud3c9\uade0\uc758 \uc808\ubc18\uc744 \ub9cc\ub4e4\uae30\ub3c4 \ud55c\ub2e4 \u2014 DQN \uc758 \ud3c9\uade0 103.7\uc904 \uc911 53%\uac00 \ud55c \ud310(547\uc904)\uc5d0\uc11c \ub098\uc654\uace0 \uc911\uc559\uac12\uc740 40\uc774\ub2e4. \ud3c9\uade0\uc73c\ub85c\ub294 DQN \uc774 A2C \ubcf4\ub2e4 \uc704\uc9c0\ub9cc \uc911\uc559\uac12\uc73c\ub85c\ub294 \ub4a4\uc9d1\ud78c\ub2e4. \ud3c9\uade0\uacfc \uc911\uc559\uac12\uc774 \ud06c\uac8c \ubc8c\uc5b4\uc9c4\ub2e4\ub294 \uc0ac\uc2e4 \uc790\uccb4\uac00 \uacb0\uacfc\uc774\ubbc0\ub85c \ub458 \ub2e4 \ud45c\uc2dc\ud55c\ub2e4.",
  "score_metric": "\uc870\uac01\ub2f9 \uc810\uc218\ub294 \ubc18\ub4dc\uc2dc \ub808\ubca8\ub85c \ub098\ub220\uc57c \ud55c\ub2e4. \ub808\ubca8 = 1 + \uc9c0\uc6b4\uc904/10 \uc774 \uac8c\uc784 \ub0b4\ub0b4 \uc624\ub974\uba70 \ubaa8\ub4e0 \uc0ad\uc81c \uc810\uc218\uc5d0 \uacf1\ud574\uc9c0\ubbc0\ub85c, \ub098\ub204\uc9c0 \uc54a\uc73c\uba74 \ub808\ubca8 60\uc5d0\uc11c\uc758 \uc2f1\uae00(6,000\uc810)\uc774 \ub808\ubca8 1\uc5d0\uc11c\uc758 \ud14c\ud2b8\ub9ac\uc2a4(800\uc810)\ubcf4\ub2e4 \ucee4\uc9c4\ub2e4. \uc989 \uadf8 \uc9c0\ud45c\ub294 '\uc5bc\ub9c8\ub098 \uc624\ub798 \uc0b4\uc558\ub098'\ub97c \ub2e4\uc2dc \uc7ac\uac8c \ub41c\ub2e4. \uc2e4\uc81c\ub85c \ubcf4\uc815 \uc804 \uc801\ud569\ub3c4\ub85c \ud559\uc2b5\ud588\uc744 \ub54c \uc870\uac01\ub2f9 1,546\uc810\uc778\ub370 \ud14c\ud2b8\ub9ac\uc2a4 \ube44\uc728 0.1%\uc778 \uc815\ucc45 \u2014 \uc624\ub798 \uc0b4\uba70 \uc2f1\uae00\ub9cc \uae01\ub294 \uc815\ucc45 \u2014 \uc774 \ub098\uc654\ub2e4."
 },
