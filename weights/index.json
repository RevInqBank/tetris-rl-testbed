   "critic_role_ko": "\u2461\uc640 \ub2e4\ub978 \uacf3\uc740 \ub531 \ud55c \uad70\ub370\ub2e4. G_t \uac00 R + \u03b3 v\u0302(S_{t+1}) \ub85c \ubc14\ub00c\uc5c8\ub2e4. \ucf54\ub4dc\uc5d0\uc11c\ub3c4 \uc815\ub9d0 \ud55c \uc904\uc774\ub2e4 (rl/pg.py \uc758 THE ONE LINE).\nv\u0302(S_{t+1}) \uc740 \uc9c0\uae08 \uac31\uc2e0\ud558\ub294 \uc0c1\ud0dc\uac00 \uc544\ub2c8\ub77c \ub2e4\uc74c \uc0c1\ud0dc\uc758 \ucd94\uc815\uac12\uc774\ub2e4. \uc774\uac8c \ud45c\uc801 \uc548\uc73c\ub85c \ub4e4\uc5b4\uac00\uba74 \uc131\uc9c8\uc774 \ub4a4\uc9d1\ud78c\ub2e4 \u2014 v\u0302 \uac00 \ud2c0\ub9b0 \ub9cc\ud07c \ud45c\uc801\uc774 \ud2c0\ub9ac\uace0, \ud45c\uc801\uc774 \ud2c0\ub9ac\uba74 \uac31\uc2e0 \ubc29\ud5a5 \uc790\uccb4\uac00 \ud2c0\ub9b0\ub2e4. \ud3b8\ud5a5\uc774 \uc0dd\uae34\ub2e4. \u2461\uc5d0\uc11c\ub294 v\u0302 \uac00 \uc544\ubb34\ub9ac \uc5c9\ud130\ub9ac\uc5ec\ub3c4 \ubc29\ud5a5\uc774 \uc548 \ubcc0\ud588\ub294\ub370 \u2462\uc5d0\uc11c\ub294 \ubcc0\ud55c\ub2e4.\n\ub300\uac00\ub85c \uc5bb\ub294 \uac83\uc740 \uc5d0\ud53c\uc18c\ub4dc\uac00 \ub05d\ub098\uae30\ub97c \uae30\ub2e4\ub9ac\uc9c0 \uc54a\uc544\ub3c4 \ub41c\ub2e4\ub294 \uac83\uc774\ub2e4. \ud55c \uc2a4\ud15d\ub9cc \ubc1f\uc73c\uba74 \ud45c\uc801\uc774 \uacc4\uc0b0\ub418\ubbc0\ub85c \uc628\ub77c\uc778\uc73c\ub85c, \ub9e4 \uc2a4\ud15d \ubc30\uc6b4\ub2e4.\n\u2192 \ud06c\ub9ac\ud2f1\uc758 \uc720\ubb34\uac00 \uc544\ub2c8\ub77c \ubd80\ud2b8\uc2a4\ud2b8\ub7a9 \ucc38\uc5ec \uc5ec\ubd80\uac00 \ubd84\ub958\ub97c \uac00\ub978\ub2e4.",
   "critic_role_ko_headline": "\ubd80\ud2b8\uc2a4\ud2b8\ub7a9 \ud45c\uc801 \u2014 \uc5ec\uae30\uc11c\ubd80\ud130 \ud06c\ub9ac\ud2f1\uc774 \uac12\uc744 \ub9e4\uae34\ub2e4",
   "update_formula": "\u03b8 \u2190 \u03b8 + \u03b1 ( R + \u03b3 v\u0302(S_{t+1}) \u2212 v\u0302(S_t) ) \u2207ln \u03c0(A_t | S_t)\nw \u2190 w + \u03b1_w ( R + \u03b3 v\u0302(S_{t+1}) \u2212 v\u0302(S_t) ) \u2207v\u0302(S_t)"
  },
